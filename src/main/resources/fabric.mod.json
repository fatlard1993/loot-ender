{
	"schemaVersion": 1,
	"id": "loot-ender",
	"version": "${version}",
	"name": "Loot Ender",
	"description": "Structure loot is rolled per player, so nobody arrives second",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"sources": "https://github.com/fatlard1993/loot-ender",
		"issues": "https://github.com/fatlard1993/loot-ender/issues"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.loot_ender.Main"
		]
	},
	"icon": "assets/loot-ender/icon.png",
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": "*"
	},
	"mixins": [
		"loot-ender.mixins.json"
	],
	"suggests": {
		"block-tip": "*",
		"chest-utils": "*"
	}
}
